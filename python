class ServicoCidadao:
    """Representa o modelo de dados de um serviço ou orientação ao cidadão."""
    def __init__(self, id_servico: int, titulo: str, categoria: str,
                 descricao: str, publico_alvo: str, canal_atendimento: str):
        self.id = id_servico
        self.titulo = titulo
        self.categoria = categoria
        self.descricao = descricao
        self.publico_alvo = publico_alvo
        self.canal_atendimento = canal_atendimento

    def __str__(self) -> str:
        return (
            f"\n----------------------------------------\n"
            f"ID: {self.id}\n"
            f"Título: {self.titulo}\n"
            f"Categoria: {self.categoria}\n"
            f"Descrição: {self.descricao}\n"
            f"Público-alvo: {self.publico_alvo}\n"
            f"Canal/Local: {self.canal_atendimento}\n"
            f"----------------------------------------"
        )


class No:
    """Nó da lista simplesmente encadeada."""
    def __init__(self, dado: ServicoCidadao):
        self.dado = dado
        self.proximo = None


class ListaEncadeadaServicos:
    """Estrutura de dados principal: Lista Simplesmente Encadeada."""
    def __init__(self):
        self.cabeca = None
        self.tamanho = 0

    def esta_vazia(self) -> bool:
        return self.cabeca is None

    def buscar_por_id(self, id_busca: int) -> ServicoCidadao | None:
        """Busca Linear por ID único. Complexidade: O(n)."""
        atual = self.cabeca
        while atual is not None:
            if atual.dado.id == id_busca:
                return atual.dado
            atual = atual.proximo
        return None

    def inserir(self, servico: ServicoCidadao) -> bool:
        """Insere um novo serviço no final da lista. Complexidade: O(n)."""
        if self.buscar_por_id(servico.id) is not None:
            return False  # ID duplicado

        novo_no = No(servico)
        if self.esta_vazia():
            self.cabeca = novo_no
        else:
            atual = self.cabeca
            while atual.proximo is not None:
                atual = atual.proximo
            atual.proximo = novo_no

        self.tamanho += 1
        return True

    def listar_todos(self) -> None:
        """Percorre e exibe todos os nós da lista. Complexidade: O(n)."""
        if self.esta_vazia():
            print("\n[Aviso] Nenhum serviço cadastrado no momento.")
            return

        print(f"\n=== LISTA DE SERVIÇOS ({self.tamanho} registro(s)) ===")
        atual = self.cabeca
        while atual is not None:
            print(atual.dado)
            atual = atual.proximo

    def atualizar(self, id_busca: int, titulo: str, categoria: str,
                  descricao: str, publico_alvo: str, canal: str) -> bool:
        """Busca o registro pelo ID e atualiza seus campos. Complexidade: O(n)."""
        servico = self.buscar_por_id(id_busca)
        if servico is None:
            return False

        servico.titulo = titulo
        servico.categoria = categoria
        servico.descricao = descricao
        servico.publico_alvo = publico_alvo
        servico.canal_atendimento = canal
        return True

    def excluir(self, id_busca: int) -> bool:
        """Remove um nó pelo ID ajustando os ponteiros. Complexidade: O(n)."""
        if self.esta_vazia():
            return False

        # Caso 1: Remoção na cabeça da lista
        if self.cabeca.dado.id == id_busca:
            self.cabeca = self.cabeca.proximo
            self.tamanho -= 1
            return True

        # Caso 2: Remoção no meio ou fim da lista
        anterior = self.cabeca
        atual = self.cabeca.proximo
        while atual is not None:
            if atual.dado.id == id_busca:
                anterior.proximo = atual.proximo
                self.tamanho -= 1
                return True
            anterior = atual
            atual = atual.proximo

        return False

    def pesquisar_por_atributo(self, termo: str, campo: str) -> list[ServicoCidadao]:
        """
        Busca Linear por substring (case-insensitive) em 'titulo' ou 'categoria'.
        Complexidade: O(n).
        """
        resultados = []
        termo_lower = termo.lower()
        atual = self.cabeca

        while atual is not None:
            valor_campo = getattr(atual.dado, campo, "").lower()
            if termo_lower in valor_campo:
                resultados.append(atual.dado)
            atual = atual.proximo

        return resultados

    def ordenar_por_titulo(self) -> None:
        """
        Algoritmo Bubble Sort adaptado diretamente para Lista Encadeada.
        Troca os objetos 'dado' entre nós adjacentes para ordenar alfabeticamente pelo título.
        Complexidade: O(n²).
        """
        if self.tamanho < 2:
            return

        trocou = True
        while trocou:
            trocou = False
            atual = self.cabeca
            while atual is not None and atual.proximo is not None:
                if atual.dado.titulo.lower() > atual.proximo.dado.titulo.lower():
                    # Troca os dados armazenados nos nós
                    atual.dado, atual.proximo.dado = atual.proximo.dado, atual.dado
                    trocou = True
                atual = atual.proximo

    def ordenar_por_id(self) -> None:
        """
        Algoritmo Bubble Sort adaptado para ordenar crescentemente pelo ID.
        Complexidade: O(n²).
        """
        if self.tamanho < 2:
            return

        trocou = True
        while trocou:
            trocou = False
            atual = self.cabeca
            while atual is not None and atual.proximo is not None:
                if atual.dado.id > atual.proximo.dado.id:
                    atual.dado, atual.proximo.dado = atual.proximo.dado, atual.dado
                    trocou = True
                atual = atual.proximo


