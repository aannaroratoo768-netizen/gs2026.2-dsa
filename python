def ler_inteiro_positivo(mensagem: str) -> int:
    while True:
        entrada = input(mensagem).strip()
        try:
            valor = int(entrada)
            if valor <= 0:
                print("[Erro] O número deve ser um inteiro positivo maior que zero.")
            else:
                return valor
        except ValueError:
            print("[Erro] Entrada inválida. Digite apenas números inteiros.")


def ler_texto_obrigatorio(mensagem: str) -> str:
    while True:
        texto = input(mensagem).strip()
        if not texto:
            print("[Erro] Este campo é obrigatório e não pode ficar vazio.")
        else:
            return texto


def carregar_dados_iniciais(lista: ListaEncadeadaServicos) -> None:
    """Popula a lista com dados fictícios para facilitar demonstrações."""
    exemplos = [
        ServicoCidadao(103, "Emissão de Segunda Via de RG", "Documentos",
                       "Solicitação de segunda via da carteira de identidade.",
                       "Cidadãos em geral", "Poupatempo / Portal Gov"),
        ServicoCidadao(101, "Cadastro Único (CadÚnico)", "Assistência Social",
                       "Inscrição para programas sociais do governo federal.",
                       "Famílias de baixa renda", "CRAS mais próximo"),
        ServicoCidadao(102, "Vacinação Infantil e Adulta", "Saúde",
                       "Aplicação de vacinas do calendário nacional.",
                       "Toda a população", "UBS - Postos de Saúde")
    ]
    for item in exemplos:
        lista.inserir(item)


