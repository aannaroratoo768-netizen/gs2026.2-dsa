def exibir_menu() -> None:
    print("\n==============================================")
    print("       CITIZEN ASSIST AI - GESTÃO DE SERVIÇOS ")
    print("==============================================")
    print("1. Cadastrar novo serviço")
    print("2. Consultar serviço por ID")
    print("3. Listar todos os serviços")
    print("4. Atualizar serviço existente")
    print("5. Excluir serviço")
    print("6. Pesquisar serviços (por Título ou Categoria)")
    print("7. Ordenar serviços (por Título ou ID)")
    print("8. Carregar dados de exemplo (Testes)")
    print("0. Sair")
    print("==============================================")


def main():
    lista_servicos = ListaEncadeadaServicos()

    while True:
        exibir_menu()
        opcao = input("Escolha uma opção: ").strip()

        if opcao == "1":
            print("\n--- CADASTRAR NOVO SERVIÇO ---")
            id_srv = ler_inteiro_positivo("ID único (número inteiro): ")
            if lista_servicos.buscar_por_id(id_srv) is not None:
                print(f"[Erro] Já existe um serviço cadastrado com o ID {id_srv}.")
                continue

            titulo = ler_texto_obrigatorio("Título do serviço: ")
            categoria = ler_texto_obrigatorio("Categoria (ex: Saúde, Documentos): ")
            descricao = ler_texto_obrigatorio("Descrição detalhada: ")
            publico = ler_texto_obrigatorio("Público-alvo: ")
            canal = ler_texto_obrigatorio("Canal ou local de atendimento: ")

            novo_servico = ServicoCidadao(id_srv, titulo, categoria, descricao, publico, canal)
            if lista_servicos.inserir(novo_servico):
                print(f"[Sucesso] Serviço '{titulo}' cadastrado com êxito!")

        elif opcao == "2":
            print("\n--- CONSULTAR POR ID ---")
            if lista_servicos.esta_vazia():
                print("[Aviso] A lista está vazia. Não há registros para consultar.")
                continue
            id_busca = ler_inteiro_positivo("Informe o ID do serviço: ")
            resultado = lista_servicos.buscar_por_id(id_busca)
            if resultado:
                print(resultado)
            else:
                print(f"[Aviso] Nenhum serviço encontrado com o ID {id_busca}.")

        elif opcao == "3":
            lista_servicos.listar_todos()

        elif opcao == "4":
            print("\n--- ATUALIZAR SERVIÇO ---")
            if lista_servicos.esta_vazia():
                print("[Aviso] A lista está vazia. Não há registros para atualizar.")
                continue
            id_busca = ler_inteiro_positivo("Informe o ID do serviço a ser atualizado: ")
            existente = lista_servicos.buscar_por_id(id_busca)
            if not existente:
                print(f"[Aviso] Serviço com ID {id_busca} não encontrado.")
                continue

            print(f"Editando: {existente.titulo}")
            titulo = ler_texto_obrigatorio("Novo Título: ")
            categoria = ler_texto_obrigatorio("Nova Categoria: ")
            descricao = ler_texto_obrigatorio("Nova Descrição: ")
            publico = ler_texto_obrigatorio("Novo Público-alvo: ")
            canal = ler_texto_obrigatorio("Novo Canal/Local: ")

            if lista_servicos.atualizar(id_busca, titulo, categoria, descricao, publico, canal):
                print("[Sucesso] Registro atualizado com sucesso!")

        elif opcao == "5":
            print("\n--- EXCLUIR SERVIÇO ---")
            if lista_servicos.esta_vazia():
                print("[Aviso] A lista está vazia. Não há registros para excluir.")
                continue
            id_busca = ler_inteiro_positivo("Informe o ID do serviço a excluir: ")
            if lista_servicos.excluir(id_busca):
                print(f"[Sucesso] Serviço ID {id_busca} removido da lista.")
            else:
                print(f"[Aviso] Serviço com ID {id_busca} não encontrado.")

        elif opcao == "6":
            print("\n--- PESQUISAR SERVIÇOS ---")
            if lista_servicos.esta_vazia():
                print("[Aviso] A lista está vazia. Cadastre registros antes de pesquisar.")
                continue
            print("Pesquisar por: [1] Título | [2] Categoria")
            tipo = input("Opção: ").strip()
            if tipo == "1":
                campo = "titulo"
            elif tipo == "2":
                campo = "categoria"
            else:
                print("[Erro] Critério de pesquisa inválido.")
                continue

            termo = ler_texto_obrigatorio("Digite o termo de busca: ")
            encontrados = lista_servicos.pesquisar_por_atributo(termo, campo)
            if encontrados:
                print(f"\n[Sucesso] {len(encontrados)} registro(s) encontrado(s):")
                for srv in encontrados:
                    print(srv)
            else:
                print(f"[Aviso] Nenhum serviço corresponde ao termo '{termo}'.")

        elif opcao == "7":
            print("\n--- ORDENAR SERVIÇOS ---")
            if lista_servicos.tamanho < 2:
                print("[Aviso] É necessário ter pelo menos 2 registros para ordenar.")
                continue
            print("Ordenar por: [1] Título (A-Z) | [2] ID (Crescente)")
            crit = input("Opção: ").strip()
            if crit == "1":
                lista_servicos.ordenar_por_titulo()
                print("[Sucesso] Lista ordenada alfabeticamente por Título!")
                lista_servicos.listar_todos()
            elif crit == "2":
                lista_servicos.ordenar_por_id()
                print("[Sucesso] Lista ordenada crescentemente por ID!")
                lista_servicos.listar_todos()
            else:
                print("[Erro] Opção de ordenação inválida.")

        elif opcao == "8":
            carregar_dados_iniciais(lista_servicos)
            print("[Sucesso] Dados fictícios de teste carregados (ignorando IDs já existentes).")

        elif opcao == "0":
            print("\nEncerrando o Citizen Assist AI. Até logo!")
            break

        else:
            print("[Erro] Opção inexistente no menu. Tente novamente.")


if __name__ == "__main__":
    main()
